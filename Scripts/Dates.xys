include "Libraries\File"

/* Sets the modified date of the selected files to the date extracted from the file names.
 *
 * File name must be in the following format: YYYYMMDD_hhmmss
 */
"SetModifiedDateFromFileName"
    $filesPaths = GetSelectedFilesRecursively("|");

    if ($filesPaths == "")
    {
        Msg("No file found in the selection.".<br>."Select at least one file or folder containing a file.", 16);
        End(1);
    }

    // Ask user if he wants to confirm modification for each file
    $confirmForEachFileMessage = "Ask for confirmation for each file? If No, the script will run on all selected file without asking for your confirmation.";
    $confirmForEachFile = Confirm($confirmForEachFileMessage, "", 1, 3);

    if ($confirmForEachFile == 2) // "Cancel"
    {
        Status("Set modified date script cancelled", "FF0000", "stop");
        End(1);
    }

    foreach ($filePath, $filesPaths, "|")
    {
        // Get file name
        $fileName = GetPathComponent($filePath, "file");
        $fileNameWithoutExtension = GetPathComponent($filePath, "base");

        // Get date
        $regexPattern = "(\d{4})(\d{2})(\d{2})_(\d{2})(\d{2})(\d{2})";
	    $replaceBy = "$3/$2/$1 $4:$5:$6"; // Must be in a format that the local system can understand.
	    $date = RegexReplace($fileNameWithoutExtension, $regexPattern, $replaceBy);

        if ($confirmForEachFile == 1) // "Yes"
        {
            // Ask user for confirmation
            $confirmationMessage = "Set modified date for the following file?" . <crlf>.<crlf> . $filePath . <crlf>.<crlf> . $date;
            $confirm = Confirm($confirmationMessage, "", 1, 3);
        }
        else
        {
            $confirm = 1;
        }

        if ($confirm == 0) // "No"
        {
            Status("Unchanged modified date for " . $fileName,, "alert");
            continue;
        }
        elseif ($confirm == 1) // "Yes"
        {
            // Set "Modified" date
            Timestamp(m, $date, $filePath);
            Status("Changed modified date for " . $fileName,, "ready");
        }
        elseif ($confirm == 2) // "Cancel"
        {
            Status("Set modified date script cancelled", "FF0000", "stop");
            End(1);
        }
    }

/* Sets the file name of the selected files to their "Modified" date.
 */
"SetFileNameFromModifiedDate"
    rename b, '<datem yyyymmdd_hhnnss>', p;

/* Sets the EXIF "Taken Date" of the selected files to the date extracted from the file names.
 *
 * File name must be in the following format: YYYYMMDD_hhmmss
 */
"SetExifTakenDateFromFileName_YYYYMMDD_HHMMSS"
    $filesPaths = GetSelectedFilesRecursively('" "'); // use " " as separator in order to pass the list of files to the ExifTool command

    if ($filesPaths == "")
    {
        Msg("No file found in the selection.".<br>."Select at least one file or folder containing a file.", 16);
        End(1);
    }

    $exifTool = "C:\Program Files\exifTool\exifTool.exe";

    run 'cmd /k ' . // Run "cmd /k" to open the command in a new console to keep it open at the end, in case there are some errors
        '"' . // Start of command
        '"' . $exifTool . '" ' . // ExifTool executable
        '"-DateTimeOriginal<Basename" ' . // Edit DateTimeOriginal (= Exif "Date taken") from Basename
        '-d "%Y%m%d_%H%M%S" ' . // Pattern used to extract the date from Basename
        '"' . $filesPaths . '"' . // List of files to edit
        '"'; // End of command

/* Sets the EXIF "Taken Date" of the selected files to the date extracted from the file names.
 *
 * File name must be in the following format: IMG_YYYYMMDD_hhmmss
 */
"SetExifTakenDateFromFileName_IMG_YYYYMMDD_HHMMSS"
    $filesPaths = GetSelectedFilesRecursively('" "'); // use " " as separator in order to pass the list of files to the ExifTool command

    if ($filesPaths == "")
    {
        Msg("No file found in the selection.".<br>."Select at least one file or folder containing a file.", 16);
        End(1);
    }

    $exifTool = "C:\Program Files\exifTool\exifTool.exe";

    run 'cmd /k ' . // Run "cmd /k" to open the command in a new console to keep it open at the end, in case there are some errors
        '"' . // Start of command
        '"' . $exifTool . '" ' . // ExifTool executable
        '"-DateTimeOriginal<Basename" ' . // Edit DateTimeOriginal (= Exif "Date taken") from Basename
        '-d "IMG_%Y%m%d_%H%M%S" ' . // Pattern used to extract the date from Basename
        '"' . $filesPaths . '"' . // List of files to edit
        '"'; // End of command

/* Add (or replace if needed) the today's date at the start of the name of the selected files/folders.
 */
"AddTodayDateInFileName"
    // Check if there's a file/folder selected
    if (Get("CountSelected") == 0)
    {
        Msg("Please select at least one file / folder to rename.", 16);
        End(1);
    }

    $now = <date yyyy-mm-dd>;
    $itemsPaths = Get('SelectedItemsPathNames', '|');

    foreach ($itemPath, $itemsPaths, "|")
    {
        $itemName = GetPathComponent($itemPath, "file");

        if (RegexMatches($itemName, "^\d{4}-\d{2}-\d{2}") != "")
        {
            // There's already a date at the start of the item name, replace it
            $newItemName = RegexReplace($itemName, "^\d{4}-\d{2}-\d{2}", $now);
        }
        else
        {
            // Prepend today's date to the item name
            $newItemName = $now . " " . $itemName;
        }

        RenameItem($newItemName, $itemPath);
    }
